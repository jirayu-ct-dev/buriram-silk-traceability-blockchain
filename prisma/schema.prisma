// ---------------------------------------------------------------------------
// Database schema for the Buriram hand-woven silk traceability system
//
// Source of truth: docs/system-design.md (sections 7, 10, 11)
// Rationale & ER diagram: docs/database-design.md
//
// Conventions:
// - Internal IDs are UUIDv7; public references use separate guess-resistant
//   codes (silk_items.public_id, certificates.certificate_code)
// - Physical table/column names are snake_case to match system-design.md
// - Ledger tables are append-only (enforced by DB triggers, see migrations)
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  WEAVER
  COOPERATIVE_OFFICER
  STORE_USER
}

enum OrganizationType {
  COOPERATIVE
  STORE
}

// system-design.md section 7.1
enum RevisionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

// Status of a certification request (a submitted revision awaiting review)
enum RequestStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

// system-design.md section 7.2
enum CertificateStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

// system-design.md section 7.3
enum TransferStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED
}

// system-design.md section 8.2 (validator authority roles)
enum ValidatorAuthorityRole {
  COOPERATIVE_AUTHORITY
  LOCAL_CERTIFIER_AUTHORITY
  RETAIL_NETWORK_AUTHORITY
}

// system-design.md section 10.7 (one block holds one domain event)
enum LedgerEventType {
  GENESIS
  ISSUE_CERTIFICATE
  TRANSFER_ACCEPTED
  CERTIFICATE_SUSPENDED
  CERTIFICATE_REACTIVATED
  CERTIFICATE_REVOKED
}

// Workflow-level audit actions that do NOT create ledger blocks
// (system-design.md sections 10.7 and 11)
enum AuditAction {
  REVISION_CREATED
  EVIDENCE_UPLOADED
  SUBMITTED_FOR_CERTIFICATION
  CERTIFICATION_APPROVED
  CERTIFICATION_REJECTED
  CERTIFICATE_SUSPENDED
  CERTIFICATE_REACTIVATED
  CERTIFICATE_REVOKED
  TRANSFER_INITIATED
  TRANSFER_ACCEPTED
  TRANSFER_REJECTED
  TRANSFER_CANCELLED
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

model Organization {
  id        String           @id @default(uuid()) @db.Uuid
  name      String
  type      OrganizationType
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  users              User[]            @relation("OrganizationMembers")
  custodianSilkItems SilkItem[]        @relation("SilkItemCustodian")
  transfersFrom      CustodyTransfer[] @relation("TransferFromOrg")
  transfersTo        CustodyTransfer[] @relation("TransferToOrg")
  issuedCertificates Certificate[]

  @@map("organizations")
}

model User {
  id             String   @id @default(uuid()) @db.Uuid
  email          String   @unique
  passwordHash   String   @map("password_hash")
  displayName    String   @map("display_name")
  role           UserRole
  isActive       Boolean  @default(true) @map("is_active")
  organizationId String?  @map("organization_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization       Organization?          @relation("OrganizationMembers", fields: [organizationId], references: [id])
  weaverProfile      WeaverProfile?
  ownedSilkItems     SilkItem[]
  submittedRequests  CertificationRequest[] @relation("RequestSubmitter")
  reviewedRequests   CertificationRequest[] @relation("RequestReviewer")
  issuedCertificates Certificate[]
  uploadedEvidence   Evidence[]
  initiatedTransfers CustodyTransfer[]      @relation("TransferInitiator")
  resolvedTransfers  CustodyTransfer[]      @relation("TransferResolver")
  auditLogs          AuditLog[]

  @@index([organizationId])
  @@map("users")
}

// Personal data of weavers (PDPA: isolated table, restricted access,
// never exposed on public pages)
model WeaverProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  fullName  String   @map("full_name")
  phone     String?
  address   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("weaver_profiles")
}

// ---------------------------------------------------------------------------
// Silk item workflow
// ---------------------------------------------------------------------------

model SilkItem {
  id             String   @id @default(uuid()) @db.Uuid
  publicId       String   @unique @map("public_id")
  ownerUserId    String   @map("owner_user_id") @db.Uuid
  custodianOrgId String   @map("custodian_org_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  ownerUser             User                   @relation(fields: [ownerUserId], references: [id])
  custodianOrg          Organization           @relation("SilkItemCustodian", fields: [custodianOrgId], references: [id])
  revisions             SilkItemRevision[]
  certificationRequests CertificationRequest[]
  certificate           Certificate?
  transfers             CustodyTransfer[]
  auditLogs             AuditLog[]

  @@index([ownerUserId])
  @@index([custodianOrgId])
  @@map("silk_items")
}

// Snapshot of the certified claims; one draft per revision number,
// rejection requires a new revision (system-design.md sections 6.2, 7.1)
model SilkItemRevision {
  id             String         @id @default(uuid()) @db.Uuid
  silkItemId     String         @map("silk_item_id") @db.Uuid
  revisionNumber Int            @map("revision_number")
  status         RevisionStatus @default(DRAFT)
  title          String
  pattern        String?
  material       String?
  technique      String?
  widthCm        Decimal?       @map("width_cm") @db.Decimal(6, 2)
  lengthCm       Decimal?       @map("length_cm") @db.Decimal(6, 2)
  productionDate DateTime?      @map("production_date")
  notes          String?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  silkItem             SilkItem              @relation(fields: [silkItemId], references: [id])
  evidence             Evidence[]
  certificationRequest CertificationRequest?
  certificate          Certificate?

  @@unique([silkItemId, revisionNumber])
  @@index([silkItemId])
  @@index([status])
  @@map("silk_item_revisions")
}

// File metadata only; binary content lives in local server storage
// (UPLOAD_DIR), SHA-256 hash is anchored in ledger events on approval
model Evidence {
  id               String   @id @default(uuid()) @db.Uuid
  revisionId       String   @map("revision_id") @db.Uuid
  fileName         String   @map("file_name")
  filePath         String   @map("file_path")
  mimeType         String   @map("mime_type")
  fileSizeBytes    Int      @map("file_size_bytes")
  sha256           String
  uploadedByUserId String   @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  revision   SilkItemRevision @relation(fields: [revisionId], references: [id])
  uploadedBy User             @relation(fields: [uploadedByUserId], references: [id])

  @@index([revisionId])
  @@index([uploadedByUserId])
  @@map("evidence_files")
}

model CertificationRequest {
  id                  String        @id @default(uuid()) @db.Uuid
  silkItemId          String        @map("silk_item_id") @db.Uuid
  revisionId          String        @unique @map("revision_id") @db.Uuid
  status              RequestStatus @default(SUBMITTED)
  submittedByUserId   String        @map("submitted_by_user_id") @db.Uuid
  reviewedByUserId    String?       @map("reviewed_by_user_id") @db.Uuid
  reviewedAt          DateTime?     @map("reviewed_at")
  rejectionReasonCode String?       @map("rejection_reason_code")
  reviewNote          String?       @map("review_note")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  silkItem    SilkItem         @relation(fields: [silkItemId], references: [id])
  revision    SilkItemRevision @relation(fields: [revisionId], references: [id])
  submittedBy User             @relation("RequestSubmitter", fields: [submittedByUserId], references: [id])
  reviewedBy  User?            @relation("RequestReviewer", fields: [reviewedByUserId], references: [id])

  @@index([silkItemId])
  @@index([status])
  @@map("certification_requests")
}

// Public read model + workflow state of an issued certificate.
// statusReason/statusChangedAt are denormalized for the public page;
// full history lives in audit_logs and ledger events.
model Certificate {
  id              String            @id @default(uuid()) @db.Uuid
  certificateCode String            @unique @map("certificate_code")
  silkItemId      String            @unique @map("silk_item_id") @db.Uuid
  revisionId      String            @unique @map("revision_id") @db.Uuid
  issuingOrgId    String            @map("issuing_org_id") @db.Uuid
  issuedByUserId  String            @map("issued_by_user_id") @db.Uuid
  status          CertificateStatus @default(ACTIVE)
  statusReason    String?           @map("status_reason")
  statusChangedAt DateTime?         @map("status_changed_at")
  issuedAt        DateTime          @default(now()) @map("issued_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  silkItem   SilkItem         @relation(fields: [silkItemId], references: [id])
  revision   SilkItemRevision @relation(fields: [revisionId], references: [id])
  issuingOrg Organization     @relation(fields: [issuingOrgId], references: [id])
  issuedBy   User             @relation(fields: [issuedByUserId], references: [id])

  @@index([issuingOrgId])
  @@index([status])
  @@map("certificates")
}

// One PENDING transfer per silk item is enforced by a partial unique index
// created in the migration SQL (Prisma PSL cannot express partial indexes)
model CustodyTransfer {
  id                String         @id @default(uuid()) @db.Uuid
  silkItemId        String         @map("silk_item_id") @db.Uuid
  fromOrgId         String         @map("from_org_id") @db.Uuid
  toOrgId           String         @map("to_org_id") @db.Uuid
  status            TransferStatus @default(PENDING)
  initiatedByUserId String         @map("initiated_by_user_id") @db.Uuid
  resolvedByUserId  String?        @map("resolved_by_user_id") @db.Uuid
  resolvedAt        DateTime?      @map("resolved_at")
  reason            String?
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  silkItem    SilkItem     @relation(fields: [silkItemId], references: [id])
  fromOrg     Organization @relation("TransferFromOrg", fields: [fromOrgId], references: [id])
  toOrg       Organization @relation("TransferToOrg", fields: [toOrgId], references: [id])
  initiatedBy User         @relation("TransferInitiator", fields: [initiatedByUserId], references: [id])
  resolvedBy  User?        @relation("TransferResolver", fields: [resolvedByUserId], references: [id])

  @@index([silkItemId])
  @@index([fromOrgId])
  @@index([toOrgId])
  @@index([status])
  @@map("custody_transfers")
}

// ---------------------------------------------------------------------------
// Local blockchain simulation (append-only)
// ---------------------------------------------------------------------------

// Public keys only; private keys never enter PostgreSQL or Git
// (server-only under VALIDATOR_KEY_DIR)
model LedgerValidator {
  id            String                 @id @default(uuid()) @db.Uuid
  validatorId   String                 @unique @map("validator_id")
  name          String
  authorityRole ValidatorAuthorityRole @map("authority_role")
  publicKey     String                 @map("public_key")
  nonce         BigInt                 @default(0)
  isActive      Boolean                @default(true) @map("is_active")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  blocks LedgerBlock[]

  @@map("ledger_validators")
}

// Append-only: UPDATE/DELETE rejected by trigger (see migration).
// hash = SHA256(index + timestamp + canonicalData + nonce + previousHash + validatorId)
// signature = Ed25519Sign(hash, validatorPrivateKey)
model LedgerBlock {
  id           String   @id @default(uuid()) @db.Uuid
  index        Int      @unique
  timestamp    DateTime
  dataHash     String   @map("data_hash")
  nonce        BigInt
  previousHash String   @map("previous_hash")
  hash         String   @unique
  validatorId  String   @map("validator_id") @db.Uuid
  signature    String
  createdAt    DateTime @default(now()) @map("created_at")

  validator LedgerValidator @relation(fields: [validatorId], references: [id])
  events    LedgerEvent[]

  @@index([validatorId])
  @@map("ledger_blocks")
}

// Append-only: UPDATE/DELETE rejected by trigger (see migration).
// aggregate_id = silk_items.public_id (uniform anchor for explorer queries);
// null only for GENESIS. payload contains no PII (IDs, codes, hashes only).
model LedgerEvent {
  id          String          @id @default(uuid()) @db.Uuid
  eventType   LedgerEventType @map("event_type")
  blockId     String          @map("block_id") @db.Uuid
  aggregateId String?         @map("aggregate_id")
  actorId     String?         @map("actor_id")
  payload     Json
  createdAt   DateTime        @default(now()) @map("created_at")

  block LedgerBlock @relation(fields: [blockId], references: [id])

  @@index([blockId])
  @@index([aggregateId])
  @@index([eventType])
  @@map("ledger_events")
}

// ---------------------------------------------------------------------------
// Cross-cutting
// ---------------------------------------------------------------------------

// Internal audit trail for workflow operations that do not create blocks
// (draft, submit, reject, transfer initiate/cancel, ...) - serves /audit/:id
model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  silkItemId  String      @map("silk_item_id") @db.Uuid
  actorUserId String?     @map("actor_user_id") @db.Uuid
  action      AuditAction
  details     Json?
  createdAt   DateTime    @default(now()) @map("created_at")

  silkItem  SilkItem @relation(fields: [silkItemId], references: [id])
  actorUser User?    @relation(fields: [actorUserId], references: [id])

  @@index([silkItemId])
  @@index([action])
  @@map("audit_logs")
}

// Central idempotency guard for important mutations (submit, approve,
// reject, status change, transfer initiate/accept). Unique key makes a
// retried request a conflict instead of a duplicate effect.
model IdempotencyKey {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  action    String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("idempotency_keys")
}
